RewriteEngine On

# Block access to VCS metadata and sensitive dotfiles (e.g. /.git/config leaks credentials)
RewriteRule (^|/)\.(git|svn|hg|env)(/|$) - [F,L]

# Pass Basic Auth to PHP-FPM
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /demo → index.html?mode=demo (30 min full access trial)
RewriteRule ^demo/?$ /index.html?mode=demo [L,QSA]

# /wea-shadow → index.html?mode=wea
RewriteRule ^wea-shadow/?$ /index.html?mode=wea [L,QSA]

# /bridge-inspector → index.html?mode=bridge (30 min Bridge Inspector demo)
RewriteRule ^bridge-inspector/?$ /index.html?mode=bridge [L,QSA]

# Protect stats page + API
<Files "stats.html">
  AuthType Basic
  AuthName "Analytics"
  AuthUserFile /etc/apache2/.htpasswd-stats
  Require valid-user
</Files>
<FilesMatch "stats\.php$">
  AuthType Basic
  AuthName "Analytics"
  AuthUserFile /etc/apache2/.htpasswd-stats
  Require valid-user
</FilesMatch>
